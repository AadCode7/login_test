# LLM provider — GraphBuilder defaults to "groq" (see main.py), so this is required.
GROQ_API_KEY=

# Only needed if you switch model_provider to "openai" in main.py / agentic_workflow.py
OPENAI_API_KEY=

# Weather tool (OpenWeatherMap) — used by tools/weather_info_tool.py
OPENWEATHERMAP_API_KEY=

# Place search — Google Places is tried first; missing this raises at graph-build
# time (before the Tavily fallback in place_search_tool.py ever runs), so treat
# it as required, not optional.
GPLACES_API_KEY=

# Place search fallback — read directly from the environment by langchain-tavily.
TAVILY_API_KEY=

# Currency conversion (exchangerate-api.com) — used by tools/currency_converter_tool.py
EXCHANGERATE_API_KEY=

# Only needed by app.py (the Streamlit UI) once it's deployed separately —
# point it at your live Vercel deployment URL, e.g. https://your-project.vercel.app
API_BASE_URL=
